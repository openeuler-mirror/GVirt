# Allowlist for the source distribution: exclude everything the
# setuptools_scm git-file finder sweeps in, then re-include only what the
# build needs. New tracked file types do not leak into the sdist by default.
global-exclude *

# project metadata and build scripts
include pyproject.toml setup.py CMakeLists.txt
include LICENSE README.md MANIFEST.in
include requirements*.txt
include xlite.spec.in

# project source code and headers
recursive-include csrc *
recursive-include xlite *.py *.pyi *.typed
recursive-include scripts *.py

# recursive-include csrc * re-adds this lint config; drop it again.
recursive-exclude csrc .clang-tidy
