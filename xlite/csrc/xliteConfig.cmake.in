#
# Self-locating package config for xlite. Ships next to the built artifacts
# under <prefix>/xlite/lib/cmake/xlite/ and resolves every path relative to
# its own location, so it carries no machine-specific paths and is relocatable.
#
# Layout it assumes:
#   <prefix>/xlite/
#       include/xlite/*.h      <- public headers (wrapped)
#       lib/libxlite.so        <- C++ runtime
#       lib/cmake/xlite/xliteConfig.cmake   <- this file
#
# Three levels up from this file == the <prefix>/xlite package root.

@PACKAGE_INIT@

get_filename_component(_XLITE_PKG_DIR "${CMAKE_CURRENT_LIST_DIR}/../../../" ABSOLUTE)

find_path(xlite_INCLUDE_DIR
    NAMES xlite/xlite.h
    HINTS "${_XLITE_PKG_DIR}/include")
find_library(xlite_LIBRARY
    NAMES xlite
    HINTS "${_XLITE_PKG_DIR}/lib")

include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(xlite
    REQUIRED_VARS xlite_LIBRARY xlite_INCLUDE_DIR)

if(xlite_FOUND AND NOT TARGET xlite::xlite)
    add_library(xlite::xlite SHARED IMPORTED)
    set_target_properties(xlite::xlite PROPERTIES
        IMPORTED_LOCATION "${xlite_LIBRARY}"
        INTERFACE_INCLUDE_DIRECTORIES "${xlite_INCLUDE_DIR}")
endif()

unset(_XLITE_PKG_DIR)
